<script>
  function initScrollReveal() {
    const els = document.querySelectorAll("[data-reveal]");
    if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
    );
    els.forEach((el) => observer.observe(el));
  }

  function initHoverLabels() {
    document.querySelectorAll(".hover-label").forEach((label) => {
      const container = label.parentElement;
      if (!container || container.dataset.hoverBound) return;
      container.dataset.hoverBound = "true";
      container.addEventListener("mousemove", (event) => {
        const rect = container.getBoundingClientRect();
        const x = event.clientX - rect.left + 16;
        const y = event.clientY - rect.top + 16;
        (label as HTMLElement).style.transform = `translate(${x}px, ${y}px)`;
      });
    });
  }

  function firstVisible(items: HTMLElement[]) {
    return items.find((item) => item.style.display !== "none");
  }

  function initCategoryFilter() {
    const buttons = document.querySelectorAll(".category-filter button");
    if (!buttons.length || (buttons[0] as HTMLElement).dataset.bound) return;

    const applyFilter = (filter: string) => {
      document.querySelectorAll<HTMLElement>(".feed-item, .reel-item").forEach((item) => {
        const show = filter === "all" || item.dataset.category === filter;
        item.style.display = show ? "" : "none";
      });
      document.querySelectorAll<HTMLElement>("[data-section]").forEach((section) => {
        const hasVisible = Array.from(
          section.querySelectorAll<HTMLElement>(".feed-item, .reel-item")
        ).some((item) => item.style.display !== "none");
        section.style.display = hasVisible ? "" : "none";
      });
      const reelItems = Array.from(document.querySelectorAll<HTMLElement>(".reel-item"));
      const visible = firstVisible(reelItems);
      if (visible) loadReelPoster(visible);
    };

    buttons.forEach((btn) => {
      (btn as HTMLElement).dataset.bound = "true";
      btn.addEventListener("click", () => {
        const filter = (btn as HTMLElement).dataset.filter || "all";
        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        applyFilter(filter);
      });
    });
  }

  function loadReelPoster(btn: HTMLElement) {
    const media = document.getElementById("reel-player-media");
    const categoryEl = document.getElementById("reel-player-category");
    const titleEl = document.getElementById("reel-player-title");
    if (!media || !categoryEl || !titleEl) return;

    const thumb = btn.dataset.thumb || "";
    media.innerHTML = thumb
      ? `<img src="${thumb}" alt="${btn.dataset.title || ""}" /><span class="reel-player-playbtn" aria-hidden="true">&#9654;</span>`
      : `<div class="placeholder-media"><span>${btn.dataset.title || ""}</span></div><span class="reel-player-playbtn" aria-hidden="true">&#9654;</span>`;
    categoryEl.textContent = btn.dataset.categoryLabel || "";
    titleEl.textContent = btn.dataset.title || "";

    document.querySelectorAll(".reel-item").forEach((el) => el.classList.remove("is-active"));
    btn.classList.add("is-active");
  }

  function playReel(btn: HTMLElement) {
    const media = document.getElementById("reel-player-media");
    const categoryEl = document.getElementById("reel-player-category");
    const titleEl = document.getElementById("reel-player-title");
    if (!media || !categoryEl || !titleEl) return;

    const vimeoId = btn.dataset.vimeo || "";
    const youtubeId = btn.dataset.youtube || "";
    const title = btn.dataset.title || "";
    const src = vimeoId
      ? `https://player.vimeo.com/video/${vimeoId}?title=0&byline=0&portrait=0&autoplay=1`
      : youtubeId
        ? `https://www.youtube.com/embed/${youtubeId}?autoplay=1`
        : "";
    if (!src) return;

    // The iframe must be created synchronously within the click handler —
    // any delay (setTimeout, etc.) drops out of the user-gesture context
    // and browsers silently block unmuted autoplay, leaving Vimeo's paused/
    // reload state instead of playing.
    media.classList.add("is-switching");
    media.innerHTML = `<iframe src="${src}" title="${title}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;
    categoryEl.textContent = btn.dataset.categoryLabel || "";
    titleEl.textContent = title;
    document.querySelectorAll(".reel-item").forEach((el) => el.classList.remove("is-active"));
    btn.classList.add("is-active");
    requestAnimationFrame(() => media.classList.remove("is-switching"));
  }

  function initReelPlayer() {
    const player = document.getElementById("reel-player");
    if (!player || player.dataset.bound) return;
    player.dataset.bound = "true";

    player.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("iframe")) return;
      const active = document.querySelector<HTMLElement>(".reel-item.is-active");
      if (active) playReel(active);
    });

    document.querySelectorAll<HTMLElement>(".reel-item").forEach((btn) => {
      if (btn.dataset.reelBound) return;
      btn.dataset.reelBound = "true";
      btn.addEventListener("click", () => playReel(btn));
    });
  }

  document.addEventListener("astro:page-load", initScrollReveal);
  document.addEventListener("astro:page-load", initHoverLabels);
  document.addEventListener("astro:page-load", initCategoryFilter);
  document.addEventListener("astro:page-load", initReelPlayer);
</script>
