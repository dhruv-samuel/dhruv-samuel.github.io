<script>
  function initScrollReveal() {
    const els = document.querySelectorAll("[data-reveal]");
    if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
    );
    els.forEach((el) => observer.observe(el));
  }

  function initHeroCarousel() {
    const carousel = document.getElementById("hero-carousel");
    if (!carousel || carousel.dataset.bound) return;
    carousel.dataset.bound = "true";

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".hero-slide"));
    if (!slides.length) return;
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-dot"));

    const resetToPoster = (slide: HTMLElement) => {
      const media = slide.querySelector<HTMLElement>("[data-carousel-media]");
      if (!media) return;
      const thumb = slide.dataset.thumb || "";
      const title = slide.dataset.title || "";
      media.innerHTML = thumb
        ? `<img src="${thumb}" alt="${title}" /><span class="reel-play reel-play-lg" aria-hidden="true"></span>`
        : `<div class="placeholder-media"><span>${title}</span></div><span class="reel-play reel-play-lg" aria-hidden="true"></span>`;
    };

    const play = (slide: HTMLElement) => {
      const media = slide.querySelector<HTMLElement>("[data-carousel-media]");
      if (!media) return;
      const vimeoId = slide.dataset.vimeo || "";
      const youtubeId = slide.dataset.youtube || "";
      const title = slide.dataset.title || "";
      const src = vimeoId
        ? `https://player.vimeo.com/video/${vimeoId}?title=0&byline=0&portrait=0&autoplay=1`
        : youtubeId
          ? `https://www.youtube.com/embed/${youtubeId}?autoplay=1`
          : "";
      if (!src) return;
      // Created synchronously inside the click handler so the browser still
      // treats this as a user gesture and allows unmuted autoplay.
      media.innerHTML = `<iframe src="${src}" title="${title}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;
    };

    slides.forEach((slide) => {
      slide.querySelector("[data-carousel-media]")?.addEventListener("click", () => play(slide));
    });

    if (slides.length < 2) return;

    let index = Math.max(
      0,
      slides.findIndex((s) => s.classList.contains("is-active"))
    );

    const goTo = (nextIndex: number) => {
      resetToPoster(slides[index]);
      slides[index].classList.remove("is-active");
      dots[index]?.classList.remove("is-active");
      index = (nextIndex + slides.length) % slides.length;
      slides[index].classList.add("is-active");
      dots[index]?.classList.add("is-active");
    };

    carousel.querySelector(".carousel-prev")?.addEventListener("click", () => goTo(index - 1));
    carousel.querySelector(".carousel-next")?.addEventListener("click", () => goTo(index + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
  }

  function initCategoryFilter() {
    const buttons = document.querySelectorAll(".category-filter button");
    if (!buttons.length || (buttons[0] as HTMLElement).dataset.bound) return;

    const applyFilter = (filter: string) => {
      document.querySelectorAll<HTMLElement>(".reel-item").forEach((item) => {
        const show = filter === "all" || item.dataset.category === filter;
        item.style.display = show ? "" : "none";
      });
    };

    buttons.forEach((btn) => {
      (btn as HTMLElement).dataset.bound = "true";
      btn.addEventListener("click", () => {
        const filter = (btn as HTMLElement).dataset.filter || "all";
        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        applyFilter(filter);
      });
    });
  }

  function initCustomCursor() {
    const supportsCursor =
      window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Re-applied on every navigation: <body> is replaced by Astro's router on
    // each page swap (unlike the persisted dot/ring below), so a class set
    // on it once at first load doesn't survive to the next page.
    document.body.classList.toggle("has-custom-cursor", supportsCursor);
    if (!supportsCursor) return;

    const dot = document.getElementById("cursor-dot");
    const ring = document.getElementById("cursor-ring");
    if (!dot || !ring || dot.dataset.bound) return;
    dot.dataset.bound = "true";

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let ringX = mouseX;
    let ringY = mouseY;

    // A short buffer of recent positions, so the ring can target where the
    // dot *was* a beat ago instead of where it is right now — an actual
    // pause before it starts moving, not just a slower catch-up curve.
    const RING_DELAY_MS = 90;
    const history: { x: number; y: number; t: number }[] = [];

    document.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      dot.style.transform = `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%)`;
      history.push({ x: mouseX, y: mouseY, t: performance.now() });
      if (history.length > 120) history.shift();
    });

    (function tick() {
      const cutoff = performance.now() - RING_DELAY_MS;
      while (history.length > 1 && history[1].t <= cutoff) {
        history.shift();
      }
      const delayed = history[0] || { x: mouseX, y: mouseY };

      // Still eases toward that delayed point (rather than snapping to it)
      // so the motion stays smooth instead of stepping between samples.
      ringX += (delayed.x - ringX) * 0.35;
      ringY += (delayed.y - ringY) * 0.35;
      ring.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%)`;
      requestAnimationFrame(tick);
    })();

    document.addEventListener("mouseover", (e) => {
      const target = (e.target as HTMLElement).closest("a, button, [data-carousel-media]");
      ring.classList.toggle("is-active", !!target);

      // Interactive (non-decorative) iframes — the Vimeo/YouTube embeds on
      // project pages and the carousel, which have real play/scrub controls
      // — are cross-origin: once the pointer is over one, its mousemove
      // events never reach this document, so our cursor would otherwise
      // freeze in place on top of the video. Hide it and let the iframe's
      // own native cursor take over; it reappears once back on plain page
      // content. Chromeless background videos (.bg-video, e.g. the homepage
      // hero) are excluded via pointer-events: none in CSS, so the pointer
      // never actually lands on them and this never fires for those.
      dot.style.opacity = (e.target as HTMLElement).tagName === "IFRAME" ? "0" : "";
      ring.style.opacity = (e.target as HTMLElement).tagName === "IFRAME" ? "0" : "";
    });

    document.addEventListener("mouseleave", () => {
      dot.style.opacity = "0";
      ring.style.opacity = "0";
    });
    document.addEventListener("mouseenter", () => {
      dot.style.opacity = "";
      ring.style.opacity = "";
    });
  }

  document.addEventListener("astro:page-load", initScrollReveal);
  document.addEventListener("astro:page-load", initHeroCarousel);
  document.addEventListener("astro:page-load", initCategoryFilter);
  document.addEventListener("astro:page-load", initCustomCursor);
</script>
