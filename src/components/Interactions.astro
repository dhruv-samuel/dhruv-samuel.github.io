<script>
  function initScrollReveal() {
    const els = document.querySelectorAll("[data-reveal]");
    if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
    );
    els.forEach((el) => observer.observe(el));
  }

  function initHeroCarousel() {
    const carousel = document.getElementById("hero-carousel");
    if (!carousel || carousel.dataset.bound) return;
    carousel.dataset.bound = "true";

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".hero-slide"));
    if (!slides.length) return;
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-dot"));

    const resetToPoster = (slide: HTMLElement) => {
      const media = slide.querySelector<HTMLElement>("[data-carousel-media]");
      if (!media) return;
      const thumb = slide.dataset.thumb || "";
      const title = slide.dataset.title || "";
      media.innerHTML = thumb
        ? `<img src="${thumb}" alt="${title}" /><span class="reel-play reel-play-lg" aria-hidden="true">&#9654;</span>`
        : `<div class="placeholder-media"><span>${title}</span></div><span class="reel-play reel-play-lg" aria-hidden="true">&#9654;</span>`;
    };

    const play = (slide: HTMLElement) => {
      const media = slide.querySelector<HTMLElement>("[data-carousel-media]");
      if (!media) return;
      const vimeoId = slide.dataset.vimeo || "";
      const youtubeId = slide.dataset.youtube || "";
      const title = slide.dataset.title || "";
      const src = vimeoId
        ? `https://player.vimeo.com/video/${vimeoId}?title=0&byline=0&portrait=0&autoplay=1`
        : youtubeId
          ? `https://www.youtube.com/embed/${youtubeId}?autoplay=1`
          : "";
      if (!src) return;
      // Created synchronously inside the click handler so the browser still
      // treats this as a user gesture and allows unmuted autoplay.
      media.innerHTML = `<iframe src="${src}" title="${title}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;
    };

    slides.forEach((slide) => {
      slide.querySelector("[data-carousel-media]")?.addEventListener("click", () => play(slide));
    });

    if (slides.length < 2) return;

    let index = Math.max(
      0,
      slides.findIndex((s) => s.classList.contains("is-active"))
    );

    const goTo = (nextIndex: number) => {
      resetToPoster(slides[index]);
      slides[index].classList.remove("is-active");
      dots[index]?.classList.remove("is-active");
      index = (nextIndex + slides.length) % slides.length;
      slides[index].classList.add("is-active");
      dots[index]?.classList.add("is-active");
    };

    carousel.querySelector(".carousel-prev")?.addEventListener("click", () => goTo(index - 1));
    carousel.querySelector(".carousel-next")?.addEventListener("click", () => goTo(index + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
  }

  function initCategoryFilter() {
    const buttons = document.querySelectorAll(".category-filter button");
    if (!buttons.length || (buttons[0] as HTMLElement).dataset.bound) return;

    const applyFilter = (filter: string) => {
      document.querySelectorAll<HTMLElement>(".reel-item").forEach((item) => {
        const show = filter === "all" || item.dataset.category === filter;
        item.style.display = show ? "" : "none";
      });
    };

    buttons.forEach((btn) => {
      (btn as HTMLElement).dataset.bound = "true";
      btn.addEventListener("click", () => {
        const filter = (btn as HTMLElement).dataset.filter || "all";
        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        applyFilter(filter);
      });
    });
  }

  document.addEventListener("astro:page-load", initScrollReveal);
  document.addEventListener("astro:page-load", initHeroCarousel);
  document.addEventListener("astro:page-load", initCategoryFilter);
</script>
