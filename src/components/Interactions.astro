<script>
  function initScrollReveal() {
    const els = document.querySelectorAll("[data-reveal]");
    if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      els.forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
    );
    els.forEach((el) => observer.observe(el));
  }

  function initHoverLabels() {
    document.querySelectorAll(".hover-label").forEach((label) => {
      const container = label.parentElement;
      if (!container || container.dataset.hoverBound) return;
      container.dataset.hoverBound = "true";
      container.addEventListener("mousemove", (event) => {
        const rect = container.getBoundingClientRect();
        const x = event.clientX - rect.left + 16;
        const y = event.clientY - rect.top + 16;
        (label as HTMLElement).style.transform = `translate(${x}px, ${y}px)`;
      });
    });
  }

  function initCategoryFilter() {
    const buttons = document.querySelectorAll(".category-filter button");
    if (!buttons.length || (buttons[0] as HTMLElement).dataset.bound) return;

    const applyFilter = (filter: string) => {
      document.querySelectorAll<HTMLElement>(".feed-item, .reel-item").forEach((item) => {
        const show = filter === "all" || item.dataset.category === filter;
        item.style.display = show ? "" : "none";
      });
      document.querySelectorAll<HTMLElement>("[data-section]").forEach((section) => {
        const hasVisible = Array.from(
          section.querySelectorAll<HTMLElement>(".feed-item, .reel-item")
        ).some((item) => item.style.display !== "none");
        section.style.display = hasVisible ? "" : "none";
      });
    };

    buttons.forEach((btn) => {
      (btn as HTMLElement).dataset.bound = "true";
      btn.addEventListener("click", () => {
        const filter = (btn as HTMLElement).dataset.filter || "all";
        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        applyFilter(filter);
      });
    });
  }

  function initReelModal() {
    const modal = document.getElementById("reel-modal");
    const player = modal?.querySelector(".reel-modal-player");
    const closeBtn = modal?.querySelector(".reel-modal-close");
    const backdrop = modal?.querySelector(".reel-modal-backdrop");
    if (!modal || !player || !closeBtn || !backdrop) return;

    const close = () => {
      modal.hidden = true;
      player.innerHTML = "";
      document.body.style.overflow = "";
    };

    const open = (vimeoId: string, youtubeId: string, title: string) => {
      const src = vimeoId
        ? `https://player.vimeo.com/video/${vimeoId}?title=0&byline=0&portrait=0&autoplay=1`
        : youtubeId
          ? `https://www.youtube.com/embed/${youtubeId}?autoplay=1`
          : "";
      if (!src) return;
      player.innerHTML = `<iframe src="${src}" title="${title}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;
      modal.hidden = false;
      document.body.style.overflow = "hidden";
    };

    document.querySelectorAll<HTMLElement>(".reel-item").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        open(btn.dataset.vimeo || "", btn.dataset.youtube || "", btn.dataset.title || "");
      });
    });

    if (!modal.dataset.bound) {
      modal.dataset.bound = "true";
      closeBtn.addEventListener("click", close);
      backdrop.addEventListener("click", close);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.hidden) close();
      });
    }
  }

  document.addEventListener("astro:page-load", initScrollReveal);
  document.addEventListener("astro:page-load", initHoverLabels);
  document.addEventListener("astro:page-load", initCategoryFilter);
  document.addEventListener("astro:page-load", initReelModal);
</script>
