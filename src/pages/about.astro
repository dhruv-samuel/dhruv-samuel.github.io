---
import Layout from "../layouts/Layout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../site.config";
import { withBase } from "../lib/url";
---
<Layout title="About">
  <section class="about-page">
    <div class="wrap">
      <div class="about-grid">
        <div class="media-block about-photo">
          <img src={withBase("/img/about.jpg")} alt={site.title} />
        </div>
        <div class="about-text">
          <h1>About</h1>
          <p>
            I'm a VFX artist and 3D generalist currently focused on environment work,
            character art, and motion — from blocking out a scene in Maya to lighting the
            final render. I like projects that mix technical problem-solving with a clear
            creative vision, whether that's a hard-surface prop, a creature turnaround, or
            compositing CG into a live-action plate.
          </p>
          <p>
            I'm currently a student looking for internship opportunities, and I'm especially
            drawn to teams working on games, film, or personal narrative projects where craft
            and pipeline both matter.
          </p>

          <h2>Software</h2>
          <ul class="tag-list stacked">
            <li>Maya</li>
            <li>ZBrush</li>
            <li>Substance Painter</li>
            <li>Nuke</li>
            <li>Unreal Engine</li>
          </ul>

          {site.resumeUrl && (
            <a class="button" href={site.resumeUrl} target="_blank" rel="noopener">
              Download résumé
            </a>
          )}

          <h2>Quick links</h2>
          <SocialLinks size="large" />
        </div>
      </div>
    </div>
  </section>
</Layout>
