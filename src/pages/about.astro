---
import Layout from "../layouts/Layout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../site.config";
import { withBase } from "../lib/url";
---
<Layout title="About">
  <section class="about-page">
    <div class="wrap">
      <div class="about-grid">
        <div class="media-block about-photo">
          <img src={withBase("/img/about.jpg")} alt={site.title} />
        </div>
        <div class="about-text">
          <h1>About</h1>
          <p>
            My name is Dhruv Samuel. I'm a visual effects artist focused on creating
            polished, cinematic work that blends CG and live-action integration with strong
            design and technical discipline. My work spans compositing, CG development, and
            motion-driven storytelling, with an emphasis on clean execution, believable
            lighting, and cohesive final images.
          </p>
          <p>
            I work across industry-standard tools such as After Effects and 3D pipelines to
            develop shots from concept through final delivery, and I approach each project
            with a problem-solving mindset—building efficient workflows, iterating quickly,
            and refining details until the work holds up at a professional standard.
            Alongside production craft, I'm also interested in AI-informed creative
            workflows and how they can support smarter iteration and experimentation
            without compromising quality.
          </p>
          <p>
            I'm drawn to projects that require both technical precision and taste:
            integrating elements seamlessly, shaping mood through lighting and color, and
            creating work that feels intentional frame to frame.
          </p>

          <h2>Software</h2>
          <ul class="tag-list stacked">
            <li>Maya</li>
            <li>ZBrush</li>
            <li>Substance Painter</li>
            <li>Nuke</li>
            <li>Unreal Engine</li>
          </ul>

          {site.resumeUrl && (
            <a class="button" href={site.resumeUrl} target="_blank" rel="noopener">
              Download résumé
            </a>
          )}

          <h2>Quick links</h2>
          <SocialLinks size="large" />
        </div>
      </div>
    </div>
  </section>
</Layout>
