---
import Layout from "../layouts/Layout.astro";
import { site } from "../site.config";
import { withBase } from "../lib/url";

// Showreel: set heroVimeoId (recommended) to embed a muted/looping/chromeless
// Vimeo background player, or heroVideo for a short local clip in public/video.
const heroVimeoId = "1167262979";
const heroVideo = "";

// Split into per-character spans so the mouse-reactive motto effect
// (Interactions.astro) can displace each letter independently.
const mottoChars = [..."Consumption ∝ Creativity"].map((ch) => ({
  ch: ch === " " ? " " : ch,
  isSymbol: ch === "∝",
}));
---
<Layout>
  <section class="hero">
    {heroVimeoId ? (
      <div class="media-block hero-media">
        <iframe
          src={`https://player.vimeo.com/video/${heroVimeoId}?background=1&autoplay=1&loop=1&byline=0&title=0`}
          allow="autoplay; fullscreen; picture-in-picture"
          loading="lazy"
        />
      </div>
    ) : heroVideo ? (
      <div class="media-block hero-media">
        <video src={withBase(heroVideo)} autoplay muted loop playsinline />
      </div>
    ) : (
      <div class="media-block hero-media placeholder-media">
        <span>Showreel goes here — set heroVimeoId (recommended) or heroVideo in src/pages/index.astro</span>
      </div>
    )}
    <div class="wrap hero-wrap">
      <div class="hero-text">
        <p class="eyebrow">Portfolio of —</p>
        <h1>{site.title}</h1>
        <p class="hero-tagline">{site.tagline}</p>
        <p class="hero-desc">{site.description}</p>
      </div>
    </div>
    <span class="hero-scroll-cue" aria-hidden="true"></span>
  </section>

  <section class="motto" id="motto">
    <div class="wrap">
      <p class="motto-text" data-reveal>
        {mottoChars.map(({ ch, isSymbol }) => (
          <span class:list={["motto-char", { "motto-symbol": isSymbol, "motto-space": ch === " " }]}>
            {ch === " " ? " " : ch}
          </span>
        ))}
      </p>
      <p class="motto-values" data-reveal>Change &bull; Unity &bull; Equity</p>
    </div>
  </section>

  <section class="work-cta">
    <a href={withBase("/work/")} class="work-cta-link" data-reveal>
      <span class="work-cta-text">See my work</span>
      <span class="work-cta-arrow" aria-hidden="true">&rarr;</span>
    </a>
  </section>
</Layout>
