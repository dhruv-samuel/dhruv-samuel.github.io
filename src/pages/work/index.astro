---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/url";
import { categories } from "../../lib/categories";

const allProjects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const usedCategories = Object.keys(categories).filter((key) =>
  allProjects.some((project) => project.data.category === key)
) as (keyof typeof categories)[];

// One coherent feed instead of a separate layout per category: the newest
// project leads as a large featured banner, everything else sits in a single
// grid underneath. The category filter narrows both at once.
const [featured, ...rest] = allProjects;
---
<Layout title="Work">
  <section class="work-page">
    <div class="wrap">
      <h1>Work</h1>
      {usedCategories.length > 1 && (
        <div class="category-filter">
          <button type="button" class="active" data-filter="all">All</button>
          {usedCategories.map((key) => (
            <button type="button" data-filter={key}>{categories[key]}</button>
          ))}
        </div>
      )}

      {featured && (
        <a
          class="reel-featured"
          href={withBase(`/work/${featured.id}/`)}
          data-reveal
          data-category={featured.data.category}
        >
          <div class="media-block reel-featured-media">
            {featured.data.thumbnail ? (
              <img src={withBase(featured.data.thumbnail)} alt={featured.data.title} />
            ) : (
              <div class="placeholder-media"><span>{featured.data.title}</span></div>
            )}
            <span class="reel-play reel-play-lg" aria-hidden="true">&#9654;</span>
          </div>
          <div class="reel-featured-caption">
            <p class="reel-category">{categories[featured.data.category]}</p>
            <h3>{featured.data.title}</h3>
          </div>
        </a>
      )}

      <div class="reel-grid">
        {rest.map((project) => (
          <a
            class="reel-item"
            href={withBase(`/work/${project.id}/`)}
            data-reveal
            data-category={project.data.category}
          >
            <div class="media-block reel-media">
              {project.data.thumbnail ? (
                <img src={withBase(project.data.thumbnail)} alt={project.data.title} loading="lazy" />
              ) : (
                <div class="placeholder-media"><span>{project.data.title}</span></div>
              )}
              <span class="reel-play" aria-hidden="true">&#9654;</span>
            </div>
            <p class="reel-category">{categories[project.data.category]}</p>
            <p class="reel-title">{project.data.title}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
