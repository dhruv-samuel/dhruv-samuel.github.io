---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/url";

const allProjects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Work">
  <section class="work-page">
    <div class="wrap">
      <h1>Work</h1>
    </div>
    <div class="project-feed">
      {allProjects.map((project) => (
        <a class="feed-item" href={withBase(`/work/${project.id}/`)}>
          <div class="media-block feed-media">
            {project.data.thumbnail ? (
              <img src={withBase(project.data.thumbnail)} alt={project.data.title} />
            ) : (
              <div class="placeholder-media"><span>{project.data.title}</span></div>
            )}
          </div>
          <div class="feed-item-caption wrap">
            <div>
              <h3>{project.data.title}</h3>
              <p class="feed-item-role">{project.data.role}</p>
            </div>
            {project.data.software.length > 0 && (
              <ul class="tag-list">
                {project.data.software.slice(0, 3).map((tool) => <li>{tool}</li>)}
              </ul>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
