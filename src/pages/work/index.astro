---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/url";
import { categories } from "../../lib/categories";

const allProjects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const usedCategories = Object.keys(categories).filter((key) =>
  allProjects.some((project) => project.data.category === key)
) as (keyof typeof categories)[];

// VFX/3D breakdowns get the full-bleed feed treatment. Short-form edits/AMVs
// get a dense thumbnail grid instead so the page stays browsable — but every
// project, in either section, links out to its own full detail page.
const caseStudies = allProjects.filter((p) => p.data.category === "vfx-3d");
const reelItems = allProjects.filter((p) => p.data.category !== "vfx-3d");
---
<Layout title="Work">
  <section class="work-page">
    <div class="wrap">
      <h1>Work</h1>
      {usedCategories.length > 1 && (
        <div class="category-filter">
          <button type="button" class="active" data-filter="all">All</button>
          {usedCategories.map((key) => (
            <button type="button" data-filter={key}>{categories[key]}</button>
          ))}
        </div>
      )}
    </div>

    {caseStudies.length > 0 && (
      <div class="case-study-section" data-section="vfx-3d">
        <div class="wrap"><h2>Case studies</h2></div>
        <div class="project-feed">
          {caseStudies.map((project) => (
            <a
              class="feed-item"
              href={withBase(`/work/${project.id}/`)}
              data-reveal
              data-category={project.data.category}
            >
              <div class="media-block feed-media">
                {project.data.thumbnail ? (
                  <img src={withBase(project.data.thumbnail)} alt={project.data.title} />
                ) : (
                  <div class="placeholder-media"><span>{project.data.title}</span></div>
                )}
                <span class="hover-label">View project &rarr;</span>
              </div>
              <div class="feed-item-caption wrap">
                <div>
                  <p class="feed-item-category">{categories[project.data.category]}</p>
                  <h3>{project.data.title}</h3>
                  <p class="feed-item-role">{project.data.role}</p>
                </div>
                {project.data.software.length > 0 && (
                  <ul class="tag-list">
                    {project.data.software.slice(0, 3).map((tool) => <li>{tool}</li>)}
                  </ul>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {reelItems.length > 0 && (
      <div class="wrap reel-section" data-section="reel">
        <h2>Edits &amp; AMVs</h2>
        <div class="reel-grid">
          {reelItems.map((project) => (
            <a
              class="reel-item"
              href={withBase(`/work/${project.id}/`)}
              data-reveal
              data-category={project.data.category}
            >
              <div class="media-block reel-media">
                {project.data.thumbnail ? (
                  <img src={withBase(project.data.thumbnail)} alt={project.data.title} loading="lazy" />
                ) : (
                  <div class="placeholder-media"><span>{project.data.title}</span></div>
                )}
                <span class="reel-play" aria-hidden="true">&#9654;</span>
              </div>
              <p class="reel-category">{categories[project.data.category]}</p>
              <p class="reel-title">{project.data.title}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</Layout>
