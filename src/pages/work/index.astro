---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/url";
import { categories } from "../../lib/categories";

const allProjects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const usedCategories = Object.keys(categories).filter((key) =>
  allProjects.some((project) => project.data.category === key)
) as (keyof typeof categories)[];

// The newest few projects lead as an arrow-controlled carousel, everything
// else sits in a single grid underneath. The category filter only narrows
// the grid — the carousel is a fixed set of highlights.
const CAROUSEL_SIZE = 5;
const carouselItems = allProjects.slice(0, CAROUSEL_SIZE);
const rest = allProjects.slice(CAROUSEL_SIZE);
---
<Layout title="Work">
  <section class="work-page">
    <div class="wrap">
      <h1>Work</h1>
      {usedCategories.length > 1 && (
        <div class="category-filter">
          <button type="button" class="active" data-filter="all">All</button>
          {usedCategories.map((key) => (
            <button type="button" data-filter={key}>{categories[key]}</button>
          ))}
        </div>
      )}

      {carouselItems.length > 0 && (
        <div class="hero-carousel" id="hero-carousel" data-reveal>
          {carouselItems.map((project, i) => (
            <div
              class={`hero-slide reel-featured${i === 0 ? " is-active" : ""}`}
              data-vimeo={project.data.vimeo_id}
              data-youtube={project.data.youtube_id}
              data-title={project.data.title}
              data-thumb={project.data.thumbnail ? withBase(project.data.thumbnail) : ""}
            >
              <div class="media-block reel-featured-media" data-carousel-media>
                {project.data.thumbnail ? (
                  <img src={withBase(project.data.thumbnail)} alt={project.data.title} />
                ) : (
                  <div class="placeholder-media"><span>{project.data.title}</span></div>
                )}
                <span class="reel-play reel-play-lg" aria-hidden="true">&#9654;</span>
              </div>
              <div class="reel-featured-caption">
                <div>
                  <p class="reel-category">{categories[project.data.category]}</p>
                  <h3>{project.data.title}</h3>
                </div>
                <a class="carousel-view-link" href={withBase(`/work/${project.id}/`)}>View project &rarr;</a>
              </div>
            </div>
          ))}
          {carouselItems.length > 1 && (
            <>
              <button type="button" class="carousel-arrow carousel-prev" aria-label="Previous video">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
              </button>
              <button type="button" class="carousel-arrow carousel-next" aria-label="Next video">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
              </button>
              <div class="carousel-dots">
                {carouselItems.map((project, i) => (
                  <button
                    type="button"
                    class={`carousel-dot${i === 0 ? " is-active" : ""}`}
                    aria-label={`Show ${project.data.title}`}
                  ></button>
                ))}
              </div>
            </>
          )}
        </div>
      )}

      <div class="reel-grid">
        {rest.map((project) => (
          <a
            class="reel-item"
            href={withBase(`/work/${project.id}/`)}
            data-reveal
            data-category={project.data.category}
          >
            <div class="media-block reel-media">
              {project.data.thumbnail ? (
                <img src={withBase(project.data.thumbnail)} alt={project.data.title} loading="lazy" />
              ) : (
                <div class="placeholder-media"><span>{project.data.title}</span></div>
              )}
              <span class="reel-play" aria-hidden="true">&#9654;</span>
            </div>
            <p class="reel-category">{categories[project.data.category]}</p>
            <p class="reel-title">{project.data.title}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
