---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Interactions from "../components/Interactions.astro";
import { site } from "../site.config";
import "../styles/main.scss";

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.tagline}`;
const pageDescription = description ?? site.description;
---
<html lang="en" data-theme={site.colorScheme}>
  <head>
    <script is:inline>
      (function () {
        function applyStoredTheme(doc) {
          try {
            var stored = localStorage.getItem("theme");
            if (stored === "light" || stored === "dark") {
              doc.documentElement.setAttribute("data-theme", stored);
            }
          } catch (e) {}
        }
        // Runs once for the initial full page load...
        applyStoredTheme(document);
        // ...and again before every client-side (view transition) navigation,
        // since each page's HTML is server-rendered with the default theme
        // and would otherwise silently reset it on every link click.
        document.addEventListener("astro:before-swap", function (event) {
          applyStoredTheme(event.newDocument);
        });
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="data:," />
    <ClientRouter />
  </head>
  <body>
    <div class="grain-overlay" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Interactions />
  </body>
</html>
